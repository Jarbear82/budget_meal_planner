                                    .placeholder("e.g. Olive Oil")
                                    .value(text_val)
                                    .helper_text("Enter the primary domain item identifier"),
                            )
                            .child(
                                NumberInput::new("showcase-number-1", number_val)
                                    .label("Density / Quantity")
