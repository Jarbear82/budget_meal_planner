                div()
                    .grid()
                    .grid_cols(2)
                    .gap_6()
                    // Card 1: Form Inputs & Numeric Controls
                    .child(
                        div()
                            .flex()
                            .flex_col()
                            .gap_4()
                            .p_5()
                            .bg(cx.theme().background)
                            .border_1()
                            .border_color(cx.theme().border)
                            .rounded_xl()
                            .shadow_sm()
                            .child(
                                div()
                                    .text_base()
                                    .font_weight(FontWeight::BOLD)
                                    .child("1. FormInput & NumberInput"),
                            )
                            .child(
                                FormInput::new("showcase-input-1")
