                Dialog::new("demo-modal-dialog", "Make Recipe Configuration")
                    .subtitle("Configure batches, yields, and optional substitutes before batching")
                    .is_open(dlg_open)
                    .on_close(cx.listener(|this, _event, _window, cx| {
                        this.dialog_is_open = false;
                        cx.notify();
